# Copiar a .env y ajustar si hace falta. Todos los valores tienen default en src/shared/config.py

# Servidor TCP
SERVER_LISTEN_HOST=
SERVER_CONNECT_HOST=localhost
SERVER_PORT=8888

# MariaDB (3307 es el puerto que expone docker-compose, para no chocar
# con un MySQL local en el 3306)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=fresh_db
DB_USER=fresh_user
DB_PASSWORD=fresh_pass
DB_ROOT_PASSWORD=root_fresh_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
